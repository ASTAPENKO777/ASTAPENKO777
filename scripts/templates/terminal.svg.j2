{#- Animated terminal banner.

    Rendered twice (dark / light) by scripts/build.py.

    Two constraints drive the implementation:

    1. GitHub loads this through <img>, so no scripts and no external
       resources run. Everything is inline CSS.
    2. The viewer's monospace font is unknown. Every <text> therefore carries
       textLength, which pins each line to an exact width no matter which font
       resolves, so the reveal masks always line up.
-#}
<svg xmlns="http://www.w3.org/2000/svg" width="{{ W }}" height="{{ H }}"
     viewBox="0 0 {{ W }} {{ H }}" role="img" aria-label="{{ alt }}">
  <title>{{ alt }}</title>

  <defs>
    <clipPath id="frame">
      <rect x="1" y="1" width="{{ W - 2 }}" height="{{ H - 2 }}" rx="10"/>
    </clipPath>

    {%- for line in lines %}
    <mask id="rev{{ loop.index0 }}">
      <rect class="r{{ loop.index0 }}" x="{{ PAD }}" y="{{ line.y - 16 }}"
            width="{{ line.width }}" height="22" fill="#fff"/>
    </mask>
    {%- endfor %}

    <pattern id="scan" width="1" height="3" patternUnits="userSpaceOnUse">
      <rect width="1" height="1" fill="{{ c.scan }}"/>
    </pattern>
  </defs>

  <style>
    .mono {
      font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas,
                   "DejaVu Sans Mono", monospace;
      font-size: {{ FONT }}px;
      white-space: pre;
    }
    .chrome  { font-size: 12px; fill: {{ c.dim }}; }
    .prompt  { fill: {{ c.accent }}; }
    .cmd     { fill: {{ c.body }}; }
    .out     { fill: {{ c.dim }}; }
    .lit     { fill: {{ c.body }}; }
    .warn    { fill: {{ c.amber }}; }

    {% for line in lines -%}
    @keyframes k{{ loop.index0 }} {
      from { transform: translateX(-{{ line.width }}px); }
      to   { transform: translateX(0); }
    }
    .r{{ loop.index0 }} {
      animation: k{{ loop.index0 }} {{ '%.2f'|format(line.dur) }}s
                 steps({{ line.chars }}) {{ '%.2f'|format(line.delay) }}s both;
    }
    {% endfor -%}

    @keyframes blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
    .caret {
      fill: {{ c.accent }};
      /* Hidden until its line has been typed. `forwards` rather than `both`
         keeps this base opacity during the delay -- `both` would apply the
         keyframe's 0% state instead and leave a block glowing in empty space. */
      opacity: 0;
      animation: blink 1.06s steps(1) {{ '%.2f'|format(caret_delay) }}s infinite forwards;
    }

    @keyframes rule { from { transform: scaleX(0); } to { transform: scaleX(1); } }
    .rule { transform-origin: {{ PAD }}px 0; animation: rule .5s ease-out .05s both; }

    @keyframes rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
    .status { animation: rise .45s ease-out {{ '%.2f'|format(status_delay) }}s both; }

    @media (prefers-reduced-motion: reduce) {
      .r0, .r1, .r2, .r3, .r4, .r5, .r6, .r7, .r8,
      .rule, .status { animation: none !important; transform: none !important; }
      .caret { animation: none !important; }
    }
  </style>

  <g clip-path="url(#frame)">
    <rect width="{{ W }}" height="{{ H }}" fill="{{ c.bg }}"/>
    <rect width="{{ W }}" height="{{ H }}" fill="url(#scan)" opacity="{{ c.scan_op }}"/>

    <!-- window chrome -->
    <rect width="{{ W }}" height="34" fill="{{ c.chrome }}"/>
    <circle cx="20" cy="17" r="4.5" fill="{{ c.accent }}" opacity=".85"/>
    <circle cx="36" cy="17" r="4.5" fill="{{ c.border }}"/>
    <circle cx="52" cy="17" r="4.5" fill="{{ c.border }}"/>
    <text class="mono chrome" x="{{ W / 2 }}" y="22" text-anchor="middle">{{ chrome_title }}</text>
    <rect class="rule" x="{{ PAD }}" y="34" width="{{ W - PAD * 2 }}" height="1" fill="{{ c.accent }}" opacity=".45"/>

    <!-- session -->
    {%- for line in lines %}
    <g mask="url(#rev{{ loop.index0 }})">
      <text class="mono" x="{{ PAD }}" y="{{ line.y }}"
            textLength="{{ line.width }}" lengthAdjust="spacing">{% for s in line.segments %}<tspan class="{{ s.cls }}">{{ s.text | e }}</tspan>{% endfor %}</text>
    </g>
    {%- endfor %}
    <rect class="caret" x="{{ caret_x }}" y="{{ caret_y }}" width="{{ CELL }}" height="17"/>

    <!-- status bar -->
    <g class="status">
      <rect x="0" y="{{ H - 30 }}" width="{{ W }}" height="30" fill="{{ c.chrome }}"/>
      <rect x="0" y="{{ H - 30 }}" width="{{ W }}" height="1" fill="{{ c.border }}"/>
      {%- for seg in status %}
      <rect x="{{ seg.x }}" y="{{ H - 30 }}" width="{{ seg.w }}" height="30"
            fill="{{ c.accent if loop.first else 'none' }}"/>
      <text class="mono" x="{{ seg.x + 14 }}" y="{{ H - 10 }}" font-size="12"
            textLength="{{ seg.tw }}" lengthAdjust="spacing"
            fill="{{ c.on_accent if loop.first else c.dim }}">{{ seg.text | e }}</text>
      {%- if not loop.last %}
      <rect x="{{ seg.x + seg.w }}" y="{{ H - 24 }}" width="1" height="18" fill="{{ c.border }}"/>
      {%- endif %}
      {%- endfor %}
    </g>

    <rect x=".5" y=".5" width="{{ W - 1 }}" height="{{ H - 1 }}" rx="10"
          fill="none" stroke="{{ c.border }}"/>
  </g>
</svg>
